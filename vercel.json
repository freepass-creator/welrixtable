{
  "rewrites": [
    { "source": "/s", "destination": "/home.html" },
    { "source": "/s/", "destination": "/home.html" },
    { "source": "/v", "destination": "/vehicles.html" },
    { "source": "/v/", "destination": "/vehicles.html" },
    { "source": "/p", "destination": "/privacy.html" },
    { "source": "/p/", "destination": "/privacy.html" },
    { "source": "/g/:slug", "destination": "/guide.html" },
    { "source": "/guide/:slug", "destination": "/guide.html?slug=:slug" }
  ],
  "headers": [
    {
      "_comment": "ERP4 임베드 허용 — 견적기 페이지를 freepasserp4 가 iframe 으로 공유. 프로덕션 커스텀 도메인은 여기에 추가.",
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' http://localhost:4004 https://*.vercel.app" }
      ]
    },
    {
      "source": "/(.*\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
